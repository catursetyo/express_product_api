                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('returns id error', () => pm.expect(pm.response.json().message).to.eql('id tidak valid'));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 - GET with invalid id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/abc",
              "host": ["{{baseUrl}}"],
              "path": ["products", "abc"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
