{
  "info": {
    "name": "Product API - Express Prisma",
    "description": "Test cases for the ExpressJS + Prisma product API. Run the collection in order with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Success flow",
      "item": [
        {
          "name": "01 - GET all products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('response is an array', () => pm.expect(body).to.be.an('array'));",
                  "pm.test('every product has id, name, price', () => {",
                  "  body.forEach((product) => {",
                  "    pm.expect(product).to.have.all.keys('id', 'name', 'price');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - GET product by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns product with id 1', () => pm.expect(body.id).to.eql(1));",
                  "pm.test('has name and price', () => pm.expect(body).to.have.all.keys('id', 'name', 'price'));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - POST create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pensil\",\n  \"price\": 3000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns created product', () => {",
                  "  pm.expect(body.name).to.eql('Pensil');",
                  "  pm.expect(body.price).to.eql(3000);",
                  "  pm.expect(body.id).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('productId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - GET created product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns the created product', () => pm.expect(body.name).to.eql('Pensil'));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - PUT update product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{productId}},\n  \"name\": \"Pensil 2B\",\n  \"price\": 4000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('product is updated', () => {",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('productId')));",
                  "  pm.expect(body.name).to.eql('Pensil 2B');",
                  "  pm.expect(body.price).to.eql(4000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - DELETE product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns delete message', () => pm.expect(pm.response.json().message).to.eql('produk berhasil dihapus'));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - GET deleted product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('returns not found message', () => pm.expect(pm.response.json().message).to.eql('produk tidak ditemukan'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validation errors",
      "item": [
        {
          "name": "08 - POST without name",
          "request": {
