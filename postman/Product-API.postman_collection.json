                ]
              }
            }
          ]
        },
        {
          "name": "10 - PUT without id",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"price\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
